# Copy to .env for local development. Placeholders only — never commit real keys.
# In production, set these as environment variables on the host (e.g. Render),
# not in a file. None of these are ever sent to the browser.

# --- Environment ---
APP_ENV=development
LOG_LEVEL=INFO

# --- LLM provider -------------------------------------------------------------
# ollama = local Ollama (development) | cloud = OpenAI-compatible endpoint (production)
LLM_PROVIDER=ollama

# Local (LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Cloud (LLM_PROVIDER=cloud) — any provider exposing POST {base_url}/chat/completions.
# No provider is selected yet; fill these in once one is chosen.
CLOUD_LLM_API_KEY=
CLOUD_LLM_BASE_URL=
CLOUD_LLM_MODEL=
CLOUD_LLM_TIMEOUT_SECONDS=60
# Optional, only for reasoning models that accept it (low/medium/high). Leave empty otherwise.
CLOUD_LLM_REASONING_EFFORT=

# Multi-key failover (LLM_PROVIDER=cloud): comma-separated keys, tried in order
# CLOUD_LLM_* (if set) -> each Groq key -> each Gemini key. Rate-limited/rejected keys
# are skipped until they recover. Use these instead of CLOUD_LLM_* for Groq/Gemini.
# Groq keys: https://console.groq.com/keys   Gemini keys: https://aistudio.google.com/apikey
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback if the primary provider fails. Only "ollama" is supported and it is
# only used when set — leave empty on a deployed server.
LLM_FALLBACK_PROVIDER=

MODEL_TEMPERATURE=0.1
MODEL_MAX_TOKENS=2048
FAST_PATH_MAX_TOKENS=400
CHAT_HISTORY_LIMIT=16
# Per-user chat requests per minute (0 = unlimited)
CHAT_RATE_LIMIT_PER_MINUTE=0

# --- Agent ---
MAX_AGENT_ITERATIONS=6
AGENT_TIMEOUT_SECONDS=360
MAX_TOOL_CALLS_PER_RUN=12

# --- Live research -------------------------------------------------------------
# Tried in order: RESEARCH_PROVIDER, then RESEARCH_FALLBACK_PROVIDERS.
# Providers without an API key are skipped. duckduckgo needs no key (unofficial,
# often blocked from cloud servers — last resort only).
RESEARCH_PROVIDER=exa
RESEARCH_FALLBACK_PROVIDERS=tavily,duckduckgo
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
EXA_API_KEY=
# Optional: Jina Reader works without a key at a low rate limit.
JINA_API_KEY=
JINA_READER_ENABLED=true

RESEARCH_CACHE_ENABLED=true
RESEARCH_CACHE_TTL_SECONDS=3600
RESEARCH_MAX_RESULTS=5
RESEARCH_MAX_FETCHED_PAGES=3
RESEARCH_TIMEOUT_SECONDS=15
RESEARCH_FETCH_TIMEOUT_SECONDS=15
RESEARCH_MAX_CHARS_PER_SOURCE=1500

# --- API ---
API_HOST=127.0.0.1
API_PORT=8080
API_KEY=change-me-in-production
REQUIRE_API_KEY=false
# Comma-separated frontend origins allowed to call the API (Vite dev server runs on 5175).
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# --- Database ---
# SQLite for local dev / demo. Use a postgresql:// URL for persistent production data.
DATABASE_URL=sqlite:///./data/agent.db

# --- Auth --- (the server refuses to start in production with the placeholder value)
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

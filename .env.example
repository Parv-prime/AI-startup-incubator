# --- Environment ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Model ---
MODEL_RUNTIME=ollama
MODEL_NAME=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
MODEL_TEMPERATURE=0.1
MODEL_MAX_TOKENS=2048

# Quick chat replies only: tried in order (key 1, then key 2), falling back to
# the local Ollama model above if both are unset or fail. All other features
# (research, financial analysis, viability scoring, tool-calling) always use
# the Ollama model above, unaffected by these keys.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-2.5-flash

# Primary fast provider for chat + tool-calling: tried in order (key 1, then
# key 2), falling back to the local Ollama model above if both fail/unset.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-20b

# --- Agent ---
MAX_AGENT_ITERATIONS=6
AGENT_TIMEOUT_SECONDS=360
MAX_TOOL_CALLS_PER_RUN=12

# --- API ---
API_HOST=127.0.0.1
API_PORT=8080
API_KEY=change-me-in-production
REQUIRE_API_KEY=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (PostgreSQL; sqlite:///./data/agent.db also works for quick local dev/tests) ---
DATABASE_URL=postgresql://myai:CHANGE_ME@127.0.0.1:5432/myai_incubator

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Frontend (frontend/.env) ---
VITE_API_BASE_URL=http://127.0.0.1:8080
